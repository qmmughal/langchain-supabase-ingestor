<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>FDA Recall Monitor — Report</title>
  <meta name="description" content="Automated FDA recall monitoring report generated by the FDA Recall Monitor agent." />
  <!-- Bootstrap 5 CDN (self-contained via integrity hash) -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH"
        crossorigin="anonymous" />
  <style>
    :root {
      --bs-body-bg: #0d1117;
      --bs-body-color: #c9d1d9;
      --card-bg: #161b22;
      --border-color: #30363d;
    }
    body { background: var(--bs-body-bg); color: var(--bs-body-color); font-family: 'Segoe UI', system-ui, sans-serif; }
    .navbar { background: #161b22 !important; border-bottom: 1px solid var(--border-color); }
    .navbar-brand { color: #58a6ff !important; font-weight: 700; font-size: 1.25rem; }
    .badge-class-i   { background-color: #da3633 !important; }
    .badge-class-ii  { background-color: #d29922 !important; }
    .badge-class-iii { background-color: #3fb950 !important; }
    .card { background: var(--card-bg); border: 1px solid var(--border-color); }
    .card-header { background: #21262d; border-bottom: 1px solid var(--border-color); }
    .table { color: var(--bs-body-color); }
    .table td, .table th { border-color: var(--border-color); vertical-align: middle; }
    .table-hover tbody tr:hover { background-color: #1c2128; }
    .stat-card { border: 1px solid var(--border-color); background: var(--card-bg); border-radius: 12px; padding: 1.25rem 1.5rem; }
    .stat-number { font-size: 2.5rem; font-weight: 700; line-height: 1; }
    .reason-cell { max-width: 320px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; cursor: help; }
    .filter-bar { background: var(--card-bg); border: 1px solid var(--border-color); border-radius: 8px; padding: 1rem; }
    footer { border-top: 1px solid var(--border-color); color: #6e7681; }
    .text-muted { color: #6e7681 !important; }
    a { color: #58a6ff; }
  </style>
</head>
<body>

<!-- ── Navbar ─────────────────────────────────────────────────────────────── -->
<nav class="navbar navbar-expand-lg sticky-top">
  <div class="container-fluid px-4">
    <span class="navbar-brand">🔍 FDA Recall Monitor</span>
    <span class="ms-auto text-muted small">Generated: {{ generated_at }}</span>
  </div>
</nav>

<div class="container-xl py-4">

  <!-- ── Summary cards ─────────────────────────────────────────────────────── -->
  <div class="row g-3 mb-4">
    {% set class_i_count   = records | selectattr('class_label', 'equalto', 'Class I')   | list | length %}
    {% set class_ii_count  = records | selectattr('class_label', 'equalto', 'Class II')  | list | length %}
    {% set class_iii_count = records | selectattr('class_label', 'equalto', 'Class III') | list | length %}
    <div class="col-6 col-md-3">
      <div class="stat-card text-center">
        <div class="stat-number text-primary">{{ records | length }}</div>
        <div class="text-muted small mt-1">Total Records</div>
      </div>
    </div>
    <div class="col-6 col-md-3">
      <div class="stat-card text-center">
        <div class="stat-number text-danger">{{ class_i_count }}</div>
        <div class="text-muted small mt-1">Class I (High Risk)</div>
      </div>
    </div>
    <div class="col-6 col-md-3">
      <div class="stat-card text-center">
        <div class="stat-number text-warning">{{ class_ii_count }}</div>
        <div class="text-muted small mt-1">Class II</div>
      </div>
    </div>
    <div class="col-6 col-md-3">
      <div class="stat-card text-center">
        <div class="stat-number text-success">{{ class_iii_count }}</div>
        <div class="text-muted small mt-1">Class III</div>
      </div>
    </div>
  </div>

  <!-- ── Run summary ───────────────────────────────────────────────────────── -->
  <div class="card mb-4">
    <div class="card-header d-flex justify-content-between align-items-center">
      <strong>Run Summary</strong>
      <span class="badge bg-secondary">{{ summary.run_id }}</span>
    </div>
    <div class="card-body">
      <div class="row g-2 small">
        <div class="col-md-6 col-lg-3"><span class="text-muted">Started:</span> {{ summary.started_at }}</div>
        <div class="col-md-6 col-lg-3"><span class="text-muted">Finished:</span> {{ summary.finished_at }}</div>
        <div class="col-md-6 col-lg-3"><span class="text-muted">Fetched:</span> {{ summary.total_fetched }}</div>
        <div class="col-md-6 col-lg-3"><span class="text-muted">New:</span> <span class="text-success fw-bold">{{ summary.total_new }}</span></div>
        <div class="col-md-6 col-lg-3"><span class="text-muted">Duplicates:</span> {{ summary.total_duplicates }}</div>
        <div class="col-md-6 col-lg-3"><span class="text-muted">Errors:</span> <span class="{% if summary.total_errors > 0 %}text-danger{% endif %}">{{ summary.total_errors }}</span></div>
        <div class="col-md-6 col-lg-3"><span class="text-muted">Categories:</span> {{ summary.categories_polled | join(', ') }}</div>
      </div>
      {% if summary.error_messages %}
      <div class="alert alert-danger mt-3 mb-0 small">
        <strong>Errors:</strong>
        <ul class="mb-0">{% for e in summary.error_messages %}<li>{{ e }}</li>{% endfor %}</ul>
      </div>
      {% endif %}
    </div>
  </div>

  <!-- ── Filter bar ────────────────────────────────────────────────────────── -->
  <div class="filter-bar mb-3 d-flex flex-wrap gap-2 align-items-center">
    <strong class="me-2">Filter:</strong>
    <input id="searchInput" type="text" class="form-control form-control-sm w-auto flex-grow-1"
           placeholder="Search product, firm, reason…" oninput="filterTable()" />
    <select id="catFilter" class="form-select form-select-sm w-auto" onchange="filterTable()">
      <option value="">All Categories</option>
      <option value="drug">Drug</option>
      <option value="device">Device</option>
      <option value="food">Food</option>
    </select>
    <select id="clsFilter" class="form-select form-select-sm w-auto" onchange="filterTable()">
      <option value="">All Classes</option>
      <option value="Class I">Class I</option>
      <option value="Class II">Class II</option>
      <option value="Class III">Class III</option>
    </select>
    <button class="btn btn-sm btn-outline-secondary" onclick="resetFilters()">Reset</button>
    <span id="countBadge" class="badge bg-primary ms-auto">{{ records | length }} shown</span>
  </div>

  <!-- ── Records table ─────────────────────────────────────────────────────── -->
  <div class="card">
    <div class="card-header"><strong>Recall Records</strong></div>
    <div class="table-responsive">
      <table class="table table-hover table-sm mb-0" id="recallTable">
        <thead>
          <tr>
            <th>Date</th>
            <th>Class</th>
            <th>Category</th>
            <th>Recall #</th>
            <th>Firm</th>
            <th>Product</th>
            <th>Reason</th>
            <th>Status</th>
          </tr>
        </thead>
        <tbody>
          {% for r in records %}
          {% set cls_badge = 'badge-class-i' if r.class_label == 'Class I' else ('badge-class-ii' if r.class_label == 'Class II' else 'badge-class-iii') %}
          <tr data-category="{{ r.category }}" data-class="{{ r.class_label }}">
            <td class="text-muted small text-nowrap">{{ r.report_date[:4] }}-{{ r.report_date[4:6] }}-{{ r.report_date[6:] if r.report_date|length == 8 else r.report_date }}</td>
            <td><span class="badge {{ cls_badge }}">{{ r.class_label }}</span></td>
            <td class="text-capitalize">{{ r.category }}</td>
            <td class="small text-nowrap">
              {% if r.source_url %}
                <a href="{{ r.source_url }}" target="_blank" rel="noopener">{{ r.recall_number or '—' }}</a>
              {% else %}
                {{ r.recall_number or '—' }}
              {% endif %}
            </td>
            <td class="small">{{ r.recalling_firm or '—' }}</td>
            <td class="small">{{ r.product_description[:100] if r.product_description else '—' }}</td>
            <td class="small reason-cell" title="{{ r.reason_for_recall }}">{{ r.reason_for_recall[:80] if r.reason_for_recall else '—' }}</td>
            <td class="small">{{ r.status or '—' }}</td>
          </tr>
          {% else %}
          <tr><td colspan="8" class="text-center text-muted py-4">No records to display.</td></tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </div>
</div>

<!-- ── Footer ─────────────────────────────────────────────────────────────── -->
<footer class="text-center py-3 mt-4">
  <small>Generated by <strong>FDA Recall Monitor</strong> · Data sourced from <a href="https://open.fda.gov/" target="_blank">openFDA</a> · {{ generated_at }}</small>
</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-YvpcrYf0tY3lHB60NNkmXc4s9bIOgUxi8T/jzmqKA3Pl4u2qf9RU+qRo/vbF5k"
        crossorigin="anonymous"></script>
<script>
  function filterTable() {
    const q = document.getElementById('searchInput').value.toLowerCase();
    const cat = document.getElementById('catFilter').value.toLowerCase();
    const cls = document.getElementById('clsFilter').value;
    const rows = document.querySelectorAll('#recallTable tbody tr[data-category]');
    let visible = 0;
    rows.forEach(row => {
      const text = row.innerText.toLowerCase();
      const rowCat = row.dataset.category || '';
      const rowCls = row.dataset.class || '';
      const matchQ = !q || text.includes(q);
      const matchCat = !cat || rowCat === cat;
      const matchCls = !cls || rowCls === cls;
      row.style.display = (matchQ && matchCat && matchCls) ? '' : 'none';
      if (matchQ && matchCat && matchCls) visible++;
    });
    document.getElementById('countBadge').textContent = visible + ' shown';
  }
  function resetFilters() {
    document.getElementById('searchInput').value = '';
    document.getElementById('catFilter').value = '';
    document.getElementById('clsFilter').value = '';
    filterTable();
  }
</script>
</body>
</html>
